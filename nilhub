local function findTarget()
	local text = string.lower(targetBox.Text or "")

	if text == "" then
		return nil
	end

	for _,p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == text
			or string.lower(p.DisplayName) == text then
			return p
		end
	end

	return nil
end

