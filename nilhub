openButton.Size = UDim2.fromOffset(110,42)
openButton.Position = UDim2.new(0,15,0.5,-21)
openButton.BackgroundColor3 = C.Background
openButton.BorderSizePixel = 0
openButton.Text = "NIL Hub"
openButton.TextColor3 = C.Text
openButton.TextSize = 17
openButton.Font = Enum.Font.Gotham
openButton.Visible = false
openButton.Parent = Gui

Instance.new("UICorner",openButton).CornerRadius = UDim.new(0,9)

openButton.MouseButton1Click:Connect(function()
	Window.Visible = true
	openButton.Visible = false
end)

-- Right-click / close shortcut
UserInputService.InputBegan:Connect(function(input,processed)
	if processed then return end

	if input.KeyCode == Enum.KeyCode.RightShift then
		Window.Visible = not Window.Visible
		openButton.Visible = not Window.Visible
	end
end)

print("NIL Hub loaded successfully.")
print("Press RightShift to hide/show the UI.")
