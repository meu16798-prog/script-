--========================================================--
-- MOBILE SIZE + POSITION
--========================================================--

local function updateMobileWindow()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	local screenW = viewport.X
	local screenH = viewport.Y

	-- Mobile
	if screenW <= 200 then

		local w = math.min(screenW - 20, 350)
		local h = math.min(screenH - 30, 330)

		-- Never make it smaller than the UI content
		w = math.max(w, 445)
		h = math.max(h, 300)

		Window.Size = UDim2.fromOffset(w,h)

		Window.Position = UDim2.new(
			0.5,
			-w/2,
			0.5,
			-h/2
		)

	-- PC / larger screen
	else

		local w = 680
		local h = 520

		Window.Size = UDim2.fromOffset(w,h)

		Window.Position = UDim2.new(
			0.5,
			-w/2,
			0.5,
			-h/2
		)
	end
end

updateMobileWindow()

local camera = workspace.CurrentCamera

if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(
		updateMobileWindow
	)
end
