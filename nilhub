local function button(parent,text,x,y,w,h)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w,h)
	b.Position = UDim2.fromOffset(x,y)
	b.BackgroundColor3 = C.Button
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = C.Text
	b.TextSize = 13
	b.Font = Enum.Font.Gotham
	b.AutoButtonColor = false
	b.Parent = parent

	Instance.new("UICorner",b).CornerRadius = UDim.new(0,6)

	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = C.Hover
	end)

	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = C.Button
	end)

	return b
end

local function toggle(parent,text,x,y,w)
	local b = button(parent,text,x,y,w,30)
	local state = false

	b.MouseButton1Click:Connect(function()
		state = not state

		if state then
			b.Text = text.." [ON]"
			b.BackgroundColor3 = C.Dark
		else
			b.Text = text
			b.BackgroundColor3 = C.Button
		end
	end)

	return b
end

