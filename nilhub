local function findTarget()
	local text = string.lower(targetBox.Text or "")

	if text == "" then return nil end

	for _,p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == text
			or string.lower(p.DisplayName) == text then
			return p
		end
	end

	return nil
end

randomButton.MouseButton1Click:Connect(function()
	local list = {}

	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= Player then
			table.insert(list,p)
		end
	end

	if #list > 0 then
		local p = list[math.random(1,#list)]
		targetBox.Text = p.DisplayName
	end
end)

