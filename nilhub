local function createTab(name)
	local tab = Instance.new("TextButton")
	tab.Size = UDim2.fromOffset(115,40)
	tab.BackgroundColor3 = C.Dark
	tab.BorderSizePixel = 0
	tab.Text = name
	tab.TextColor3 = C.Text
	tab.TextSize = 17
	tab.Font = Enum.Font.Gotham
	tab.AutoButtonColor = false
	tab.Parent = TabBar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,8)
	corner.Parent = tab

	tab.MouseEnter:Connect(function()
		if not Pages[name].Visible then
			tab.BackgroundColor3 = Color3.fromRGB(65,105,143)
		end
	end)

	tab.MouseLeave:Connect(function()
		if not Pages[name].Visible then
			tab.BackgroundColor3 = C.Dark
		end
	end)

	tab.MouseButton1Click:Connect(function()
		for pageName,page in pairs(Pages) do
			page.Visible = (pageName == name)
		end

		for _,obj in ipairs(TabBar:GetChildren()) do
			if obj:IsA("TextButton") then
				obj.BackgroundColor3 = C.Dark
			end
		end

		tab.BackgroundColor3 = C.Button
	end)

	return tab
end

