local function findPlayer(text)
	if not text or text == "" then
		return nil
	end

	text = string.lower(text)

	for _,p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == text
			or string.lower(p.DisplayName) == text then
			return p
		end
	end

	return nil
end

